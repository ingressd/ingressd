[Unit]
Description=ingressd edge proxy (Caddy)
Documentation=https://github.com/ingressd/ingressd
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=ingressd
Group=ingressd
# --resume serves the last applied config immediately at boot, before the
# control plane is up; the bootstrap file only sets the admin socket.
ExecStart=/usr/local/bin/ingressd-edge run --environ --resume --config /etc/ingressd-edge/bootstrap.json
ExecReload=/usr/local/bin/ingressd-edge reload --config /etc/ingressd-edge/bootstrap.json --force
Environment=XDG_DATA_HOME=/var/lib/ingressd-edge XDG_CONFIG_HOME=/var/lib/ingressd-edge
# /run/ingressd holds the edge's admin socket and the control plane's
# sockets. It is created at boot by tmpfiles.d (deploy/systemd/
# ingressd.tmpfiles, not RuntimeDirectory=, which the edge user would own):
# root's, sticky and group-writable, so the edge can create its socket but
# not replace the control plane's.
StateDirectory=ingressd-edge
TimeoutStopSec=5s
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/ingressd/caddy /var/lib/ingressd/cache /var/lib/ingressd/waf /var/lib/ingressd-edge /run/ingressd
Restart=on-failure

[Install]
WantedBy=multi-user.target
