{
  "admin": {
    "listen": "unix//run/ingressd/caddy-admin.sock"
  },
  "apps": {
    "crowdsec": {
      "api_key": "CS-KEY",
      "api_url": "http://127.0.0.1:8080",
      "enable_hard_fails": false
    },
    "http": {
      "servers": {
        "edge": {
          "allow_0rtt": false,
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "handle": [
                {
                  "handler": "headers",
                  "request": {
                    "delete": [
                      "Upgrade"
                    ]
                  }
                }
              ],
              "match": [
                {
                  "header": {
                    "Upgrade": []
                  },
                  "not": [
                    {
                      "vars_regexp": {
                        "{http.request.header.Upgrade}": {
                          "pattern": "(?i)^\\s*(websocket|spdy/3\\.1|tcp)\\s*$"
                        }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "request": {
                            "delete": [
                              "X-Edge-User",
                              "X-Edge_User",
                              "X_Edge-User",
                              "X_Edge_User",
                              "X-Edge-User-Email",
                              "X-Edge-User_Email",
                              "X-Edge_User-Email",
                              "X-Edge_User_Email",
                              "X_Edge-User-Email",
                              "X_Edge-User_Email",
                              "X_Edge_User-Email",
                              "X_Edge_User_Email",
                              "Edge-Jwt-Assertion",
                              "Edge-Jwt_Assertion",
                              "Edge_Jwt-Assertion",
                              "Edge_Jwt_Assertion",
                              "X-Edge-Service-Token",
                              "X-Edge-Service_Token",
                              "X-Edge_Service-Token",
                              "X-Edge_Service_Token",
                              "X_Edge-Service-Token",
                              "X_Edge-Service_Token",
                              "X_Edge_Service-Token",
                              "X_Edge_Service_Token",
                              "X-Edge-Session-Id",
                              "X-Edge-Session_Id",
                              "X-Edge_Session-Id",
                              "X-Edge_Session_Id",
                              "X_Edge-Session-Id",
                              "X_Edge-Session_Id",
                              "X_Edge_Session-Id",
                              "X_Edge_Session_Id"
                            ]
                          }
                        },
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "body": "Forbidden\n",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "remote_ip": {
                                    "ranges": [
                                      "203.0.113.0/24"
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "body": "Forbidden\n",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "not": [
                                    {
                                      "maxmind_geolocation": {
                                        "db_path": "/var/lib/ingressd/geoip/GeoLite2-Country-20261102T000000.mmdb",
                                        "deny_countries": [
                                          "KP"
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "handler": "crowdsec"
                        },
                        {
                          "handler": "rate_limit",
                          "rate_limits": {
                            "docs_0": {
                              "key": "{http.request.header.X-Edge-User-Email}",
                              "match": [
                                {
                                  "header_regexp": {
                                    "X-Edge-User-Email": {
                                      "pattern": ".+"
                                    }
                                  },
                                  "path": [
                                    "/search"
                                  ]
                                }
                              ],
                              "max_events": 5,
                              "window": "1s"
                            }
                          }
                        },
                        {
                          "directives": "Include @coraza.conf-recommended\nInclude @crs-setup.conf.example\nSecRuleEngine DetectionOnly\nSecResponseBodyAccess On\nSecAuditEngine RelevantOnly\nSecAuditLogRelevantStatus \"^40[03]$\"\nSecAuditLogParts AFHKZ\nSecAuditLogFormat JSON\nSecAuditLogType Serial\nSecAuditLogFileMode 0640\nSecAuditLog /var/lib/ingressd/waf/audit.log\nSecAction \"id:900000,phase:1,pass,t:none,nolog,setvar:tx.blocking_paranoia_level=1\"\nSecAction \"id:900110,phase:1,pass,t:none,nolog,setvar:tx.inbound_anomaly_score_threshold=5,setvar:tx.outbound_anomaly_score_threshold=4\"\nInclude @owasp_crs/*.conf\n",
                          "handler": "waf",
                          "load_owasp_crs": true
                        },
                        {
                          "handler": "reverse_proxy",
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            }
                          },
                          "transport": {
                            "dial_timeout": "5s",
                            "protocol": "http"
                          },
                          "upstreams": [
                            {
                              "dial": "192.168.0.18:8080"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "docs.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "subroute",
                  "routes": [
                    {
                      "handle": [
                        {
                          "handler": "headers",
                          "request": {
                            "delete": [
                              "X-Edge-User",
                              "X-Edge_User",
                              "X_Edge-User",
                              "X_Edge_User",
                              "X-Edge-User-Email",
                              "X-Edge-User_Email",
                              "X-Edge_User-Email",
                              "X-Edge_User_Email",
                              "X_Edge-User-Email",
                              "X_Edge-User_Email",
                              "X_Edge_User-Email",
                              "X_Edge_User_Email",
                              "Edge-Jwt-Assertion",
                              "Edge-Jwt_Assertion",
                              "Edge_Jwt-Assertion",
                              "Edge_Jwt_Assertion",
                              "X-Edge-Service-Token",
                              "X-Edge-Service_Token",
                              "X-Edge_Service-Token",
                              "X-Edge_Service_Token",
                              "X_Edge-Service-Token",
                              "X_Edge-Service_Token",
                              "X_Edge_Service-Token",
                              "X_Edge_Service_Token",
                              "X-Edge-Session-Id",
                              "X-Edge-Session_Id",
                              "X-Edge_Session-Id",
                              "X-Edge_Session_Id",
                              "X_Edge-Session-Id",
                              "X_Edge-Session_Id",
                              "X_Edge_Session-Id",
                              "X_Edge_Session_Id"
                            ]
                          }
                        },
                        {
                          "handler": "subroute",
                          "routes": [
                            {
                              "handle": [
                                {
                                  "body": "Forbidden\n",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "remote_ip": {
                                    "ranges": [
                                      "203.0.113.0/24"
                                    ]
                                  }
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "body": "Forbidden\n",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "not": [
                                    {
                                      "remote_ip": {
                                        "ranges": [
                                          "198.51.100.0/24",
                                          "2001:db8::/32"
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "body": "Forbidden\n",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "not": [
                                    {
                                      "maxmind_geolocation": {
                                        "db_path": "/var/lib/ingressd/geoip/GeoLite2-Country-20261102T000000.mmdb",
                                        "deny_countries": [
                                          "KP"
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            },
                            {
                              "handle": [
                                {
                                  "body": "Forbidden\n",
                                  "handler": "static_response",
                                  "status_code": 403
                                }
                              ],
                              "match": [
                                {
                                  "not": [
                                    {
                                      "maxmind_geolocation": {
                                        "db_path": "/var/lib/ingressd/geoip/GeoLite2-ASN-20261102T000000.mmdb",
                                        "deny_asn": [
                                          "64496"
                                        ]
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ]
                        },
                        {
                          "handler": "crowdsec"
                        },
                        {
                          "handler": "edge_client_net"
                        },
                        {
                          "handler": "rate_limit",
                          "rate_limits": {
                            "web_0": {
                              "key": "{http.vars.client_net}",
                              "match": [
                                {
                                  "path": [
                                    "/login"
                                  ]
                                }
                              ],
                              "max_events": 10,
                              "window": "1m0s"
                            },
                            "web_1": {
                              "key": "{http.request.header.X-Api-Key}",
                              "match": [
                                {
                                  "path": [
                                    "/api/*"
                                  ]
                                }
                              ],
                              "max_events": 100,
                              "window": "1m0s"
                            }
                          }
                        },
                        {
                          "difficulty": 16,
                          "exempt_paths": [
                            "/api/*"
                          ],
                          "good_bots": true,
                          "handler": "edge_challenge",
                          "key": "CHALLENGE-KEY",
                          "mode": "suspicious",
                          "rate_rules": [
                            {
                              "key": "ip",
                              "path": "/signup",
                              "requests": 3,
                              "window": "10m0s"
                            }
                          ],
                          "ttl": "24h0m0s"
                        },
                        {
                          "directives": "Include @coraza.conf-recommended\nInclude @crs-setup.conf.example\nSecRuleEngine On\nSecResponseBodyAccess Off\nSecAuditEngine RelevantOnly\nSecAuditLogRelevantStatus \"^40[03]$\"\nSecAuditLogParts AFHKZ\nSecAuditLogFormat JSON\nSecAuditLogType Serial\nSecAuditLogFileMode 0640\nSecAuditLog /var/lib/ingressd/waf/audit.log\nSecAction \"id:900000,phase:1,pass,t:none,nolog,setvar:tx.blocking_paranoia_level=2\"\nSecAction \"id:900110,phase:1,pass,t:none,nolog,setvar:tx.inbound_anomaly_score_threshold=5,setvar:tx.outbound_anomaly_score_threshold=4\"\nSecRule REQUEST_FILENAME \"@beginsWith /api/search\" \"id:10000,phase:1,pass,t:none,nolog,ctl:ruleRemoveTargetById=942100;ARGS:q\"\nSecRule REQUEST_FILENAME \"@beginsWith /cms/\" \"id:10001,phase:1,pass,t:none,nolog,ctl:ruleRemoveByTag=attack-xss\"\nSecAction \"id:10002,phase:1,pass,t:none,nolog,ctl:ruleRemoveById=920350\"\nInclude @owasp_crs/*.conf\n",
                          "handler": "waf",
                          "load_owasp_crs": true
                        },
                        {
                          "handler": "reverse_proxy",
                          "load_balancing": {
                            "selection_policy": {
                              "policy": "round_robin"
                            }
                          },
                          "transport": {
                            "dial_timeout": "5s",
                            "protocol": "http"
                          },
                          "upstreams": [
                            {
                              "dial": "192.168.0.17:8080"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "web.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "body": "Unknown host\n",
                  "handler": "static_response",
                  "status_code": 404
                }
              ]
            }
          ]
        }
      }
    },
    "pki": {
      "certificate_authorities": {
        "local": {
          "install_trust": false
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "module": "internal"
              }
            ]
          }
        ]
      }
    }
  }
}
