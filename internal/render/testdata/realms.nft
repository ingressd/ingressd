add table inet homeedge # legacy homeedge name, remove after 2027-01
delete table inet homeedge # legacy homeedge name, remove after 2027-01
add table ip homeedge_nat # legacy homeedge name, remove after 2027-01
delete table ip homeedge_nat # legacy homeedge name, remove after 2027-01
add table ip homeedge_l4 # legacy homeedge name, remove after 2027-01
delete table ip homeedge_l4 # legacy homeedge name, remove after 2027-01
add table ip homeedge_smartdns # legacy homeedge name, remove after 2027-01
delete table ip homeedge_smartdns # legacy homeedge name, remove after 2027-01
add table inet ingressd
delete table inet ingressd
add table ip ingressd_nat
delete table ip ingressd_nat
add table ip ingressd_l4
delete table ip ingressd_l4

table inet ingressd {
	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		iifname "ix-tb4x9p01" ip saddr 10.100.2.2 ip daddr 10.100.2.1 tcp dport 51819 accept
		iifname "ix-tq7k2m01" ip saddr 10.100.1.2 ip daddr 10.100.1.1 tcp dport 51819 accept
		iifname { "ix-tb4x9p01", "ix-tq7k2m01" } drop
		meta l4proto { icmp, ipv6-icmp } accept
		tcp dport { 22, 80, 443 } accept
		udp dport { 443, 51820, 51821 } accept
	}

	chain forward {
		type filter hook forward priority filter; policy drop;
		ct state established,related accept
	}

	chain output {
		type filter hook output priority filter; policy accept;
		meta skuid != 0 meta l4proto tcp ip daddr { 169.254.0.0/16 } drop
	}
}

table ip ingressd_nat {
	map vprefix_mark {
		type ipv4_addr : mark
		flags interval
		elements = { 10.0.5.0/24 : 1202, 10.0.4.0/24 : 1201 }
	}

	chain output_route {
		type route hook output priority mangle; policy accept;
		meta mark set ip daddr map @vprefix_mark
	}

	chain output_nat {
		type nat hook output priority -100; policy accept;
		dnat ip prefix to ip daddr map { 10.0.5.0/24 : 192.168.1.0/24, 10.0.4.0/24 : 192.168.1.0/24 }
	}
}
add table ip ingressd_smartdns
delete table ip ingressd_smartdns
